# Variables pour docker-compose.yml
# Copier ce fichier en .env et remplir les valeurs

DB_USER=goconnexion
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=goconnexion

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# SMTP alertes Grafana — relais SMTP de Resend, réutilise la clé API du backend.
# docker-compose ne lit que ce fichier .env pour interpoler ${...} dans
# docker-compose.yml (le env_file du backend n'est pas visible ici), donc la
# même clé RESEND_API_KEY que dans backend/.env.production doit être recopiée
# ci-dessous pour rester en phase si elle est régénérée.
RESEND_API_KEY=re_CHANGE_ME_SAME_AS_BACKEND
GRAFANA_SMTP_FROM_ADDRESS=no-reply@goconnexions.com
